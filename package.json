{
  "name": "tasknest",
  "version": "1.0.0",
  "description": "TaskNest - Full Stack To-Do List Application with Node.js, Express, and MongoDB",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "server": "node server/src/server.js",
    "config-db": "powershell -ExecutionPolicy Bypass -File scripts/setup-db.ps1"
  },
  "keywords": [
    "todo",
    "tasknest",
    "task-manager",
    "mongodb",
    "express",
    "nodejs",
    "vanilla-js"
  ],
  "author": "TaskNest",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "puppeteer-core": "^24.2.0"
  }
}
