# TaskNest Environment Configuration

PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_connection_string

# Example MongoDB Atlas URI format:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/tasknest?retryWrites=true&w=majority

# Optional: Set to true ONLY if you want to run an ephemeral in-memory database for local testing without Atlas
# USE_IN_MEMORY_DB=false
